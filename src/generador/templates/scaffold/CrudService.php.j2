<?php

namespace App\Services;

use App\Models\db{{ prefijo }}\{{ prefijo }}_procesosaudit;
{% if use_token_class %}
use App\Support\Token;
{% else %}
use Illuminate\Support\Facades\Auth;
{% endif %}
use Illuminate\Database\Eloquent\Model;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Str;

class CrudService
{
    /**
     * Pkid del usuario autenticado, o null si no hay ninguno (proceso
     * automático: job, comando artisan, sincronización) — ver Auditoría.md.
     */
    protected function currentUserPkid(): ?int
    {
{% if use_token_class %}
        return Token::user()?->pkid;
{% else %}
        // No se encontró una clase Token propia en este proyecto durante el
        // análisis — se usa Auth::user() nativo de Laravel, funcionalmente
        // equivalente bajo Sanctum (resuelve el mismo usuario autenticado
        // del guard). Si el proyecto agrega más adelante su propio helper
        // de token (ver Token y Sesión.md del estándar), esta es la única
        // línea que hay que reemplazar.
        return Auth::user()?->pkid;
{% endif %}
    }

    public function create(string $modelClass, array $data, ?string $proceso = null): Model
    {
        return DB::transaction(function () use ($modelClass, $data, $proceso) {
            $userPkid = $this->currentUserPkid();

            $data['id'] ??= Str::uuid()->toString();
            if ($userPkid !== null) {
                $data['created_by_id'] = $userPkid;
                $data['updated_by_id'] = $userPkid;
            }

            $model = $modelClass::create($data);

            if ($proceso) {
                $this->audit($proceso, {{ prefijo }}_procesosaudit::TIPO_INSERCION, $userPkid, $modelClass, $model->pkid, null, $model->toArray());
            }

            return $model;
        });
    }

    public function update(Model $model, array $data, ?string $proceso = null): Model
    {
        return DB::transaction(function () use ($model, $data, $proceso) {
            $userPkid = $this->currentUserPkid();
            if ($userPkid !== null) {
                $data['updated_by_id'] = $userPkid;
            }

            $input = $model->toArray();
            $model->update($data);
            $output = $model->refresh()->toArray();

            // Comparación estricta — si nada cambió, no saturar la auditoría
            // con filas idénticas (ver CrudService.md#No auditar updates sin
            // cambios reales).
            if ($proceso && $input !== $output) {
                $this->audit($proceso, {{ prefijo }}_procesosaudit::TIPO_ACTUALIZACION, $userPkid, get_class($model), $model->pkid, $input, $output);
            }

            return $model;
        });
    }

    public function delete(Model $model, ?string $proceso = null): Model
    {
        return DB::transaction(function () use ($model, $proceso) {
            $userPkid = $this->currentUserPkid();
            $input = $model->toArray();

            if ($userPkid !== null) {
                $model->deleted_by_id = $userPkid;
                $model->save();
            }
            $model->delete();

            if ($proceso) {
                $this->audit($proceso, {{ prefijo }}_procesosaudit::TIPO_ELIMINACION, $userPkid, get_class($model), $model->pkid, $input, null);
            }

            return $model;
        });
    }

    public function restore(Model $model, ?string $proceso = null): Model
    {
        return DB::transaction(function () use ($model, $proceso) {
            $userPkid = $this->currentUserPkid();
            $input = $model->toArray();

            if ($userPkid !== null) {
                $model->updated_by_id = $userPkid;
            }
            $model->restore();

            if ($proceso) {
                $this->audit($proceso, {{ prefijo }}_procesosaudit::TIPO_RESTAURACION, $userPkid, get_class($model), $model->pkid, $input, $model->toArray());
            }

            return $model;
        });
    }

    public function bulkInsert(string $modelClass, array $rows, ?string $proceso = null, int $chunkSize = 500): int
    {
        $userPkid = $this->currentUserPkid();
        $now = now();
        $total = 0;

        return DB::transaction(function () use ($modelClass, $rows, $proceso, $chunkSize, $userPkid, $now, &$total) {
            $model = new $modelClass();
            $table = $model->getTable();
            $connection = $model->getConnectionName();

            foreach (array_chunk($rows, $chunkSize) as $chunk) {
                foreach ($chunk as &$row) {
                    $row['id'] ??= Str::uuid()->toString();
                    if ($userPkid !== null) {
                        $row['created_by_id'] = $userPkid;
                    }
                    $row['created_at'] = $now;
                    $row['updated_at'] = $now;
                }
                unset($row);

                // No dispara eventos Eloquent ni Observers — inserta directo.
                DB::connection($connection)->table($table)->insert($chunk);
                $total += count($chunk);
            }

            if ($proceso) {
                $this->audit($proceso, {{ prefijo }}_procesosaudit::TIPO_INSERCION, $userPkid, $modelClass, null, null, ['total_insertados' => $total]);
            }

            return $total;
        });
    }

    public function find(string $modelClass, int|string $id): Model
    {
        return $modelClass::findOrFail($id);
    }

    public function getAll(string $modelClass, bool $paginate = true): mixed
    {
        $query = $modelClass::useFilters();

        return $paginate ? $query->dynamicPaginate() : $query->get();
    }

    /** Modifica $data por referencia. Salta campos ausentes en $data. */
    public function mapUuidsToPkids(array &$data, array $mapping): void
    {
        foreach ($mapping as $field => $modelClass) {
            if (! array_key_exists($field, $data)) {
                continue;
            }
            $data[$field] = $modelClass::where('id', $data[$field])->value('pkid') ?? 0;
        }
    }

    /** 1 query por modelo, no N queries por fila — ver Mapeo UUID PKID.md. */
    public function mapUuidsToPkidsBulk(array &$rows, array $mapping): void
    {
        foreach ($mapping as $field => $modelClass) {
            $uuids = array_unique(array_filter(array_column($rows, $field)));
            if (! $uuids) {
                continue;
            }
            $dictionary = $modelClass::whereIn('id', $uuids)->pluck('pkid', 'id');
            foreach ($rows as &$row) {
                if (array_key_exists($field, $row)) {
                    $row[$field] = $dictionary[$row[$field]] ?? 0;
                }
            }
            unset($row);
        }
    }

    protected function audit(
        string $proceso,
        int $tipo,
        ?int $userPkid,
        string $modelAfectado,
        int|string|null $registroId,
        ?array $input,
        ?array $output,
        ?string $error = null,
    ): void {
        {{ prefijo }}_procesosaudit::create([
            'id' => Str::uuid()->toString(),
            'nombre_proceso' => $proceso,
            'tipo_proceso' => $tipo,
            'estado_proceso' => $error ? {{ prefijo }}_procesosaudit::ESTADO_ERROR : {{ prefijo }}_procesosaudit::ESTADO_EXITO,
            'origen' => $userPkid !== null ? {{ prefijo }}_procesosaudit::ORIGEN_MANUAL : {{ prefijo }}_procesosaudit::ORIGEN_AUTOMATICO,
            'modelo_afectado' => class_basename($modelAfectado),
            'registro_id' => $registroId,
            'input' => $input,
            'output' => $output,
            'error' => $error,
            'created_by_id' => $userPkid,
        ]);
    }
}
