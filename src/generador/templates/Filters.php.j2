<?php

namespace {{ manifest.ns('filters') }};

{% for fqcn in fk_model_imports %}
use {{ fqcn }};
{% endfor %}
use Essa\APIToolKit\Filters\QueryFilters;

class {{ manifest.cls('filters') }} extends QueryFilters
{
    // Campos permitidos para búsqueda de texto libre (LIKE) — ver ?search=
    // OJO: la propiedad real de QueryFilters se llama $columnSearch, no $allowedSearch
    // (no existe $allowedSearch en el paquete — ver useFilters.md)
    protected array $columnSearch = [
{% for f in search_fields %}
        '{{ f.name }}',
{% endfor %}
    ];

    // Campos permitidos para filtro por valor exacto — ver ?campo=valor
    // Solo columnas directas. Los FK *_id van como método resolver más abajo
    // (ver useFilters.md#FKs que guardan pkid) — nunca acá también: si un
    // campo tiene método Y está en $allowedFilters, QueryFilters aplica los
    // dos WHERE (el resolver y el genérico), y el genérico compara el UUID
    // crudo contra la columna entera — esa condición nunca matchea, y en AND
    // con la primera el resultado queda siempre vacío.
    protected array $allowedFilters = [
{% for f in fields %}
        '{{ f.name }}',
{% endfor %}
    ];

    // Relaciones permitidas para eager loading desde query param — ver ?include=
    protected array $allowedIncludes = [
{% for rel in relations %}
        '{{ rel.method }}',
{% endfor %}
    ];

    // Campos permitidos para ordenamiento — ver ?sorts=
    // Mismo criterio que $allowedFilters: sin los FK *_id (el pkid es un
    // detalle interno, no un orden con sentido de negocio para el frontend).
    protected array $allowedSorts = [
{% for f in fields %}
        '{{ f.name }}',
{% endfor %}
        'created_at',
        'updated_at',
    ];
{% for f in fk_fields %}

    // {{ f.name }} guarda el pkid en la columna, pero el frontend filtra por UUID
    // (igual que en el payload de create/update) — sin este método, useFilters()
    // compararía el UUID crudo contra la columna entera y nunca matchearía nada.
    public function {{ f.name }}($value)
    {
        if ($value === null || $value === '') {
            return $this->builder;
        }

        $pkid = {{ manifest.related_model_short(f.fk_table) }}::where('id', $value)->value('pkid');

        // Si el UUID no resuelve a un pkid, forzar 0 para que el filtro
        // devuelva vacío — nunca whereNull, que traería las filas con
        // '{{ f.name }}' nulo (ver useFilters.md#FKs que guardan pkid)
        return $this->builder->where('{{ f.name }}', $pkid ?? 0);
    }
{% endfor %}
}
