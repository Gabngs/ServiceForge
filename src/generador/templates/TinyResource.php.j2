<?php

namespace App\Http\Resources\{{ manifest.prefijo_studly }};

use Illuminate\Http\Resources\Json\JsonResource;

// Mínimo — usado por el propio index() del módulo cuando el Controller recibe
// ?tiny=true (selectores/dropdowns del frontend). Ver ApiResponse.md#Resource
// triple: completo, relación y tiny / Controller.md#Parámetro `tiny`.
/**
 * @OA\Schema(
 *     schema="{{ manifest.modulo_studly }}TinySchema",
 *     @OA\Property(property="id", type="string", format="uuid"){{ "," if tiny_fields else "" }}
{% for f in tiny_fields %}
 *     @OA\Property(property="{{ f.name }}", type="{{ f.oa_type() }}"{% if f.oa_format() %}, format="{{ f.oa_format() }}"{% endif %}){{ "," if not loop.last else "" }}
{% endfor %}
 * )
 */
class {{ manifest.modulo_studly }}TinyResource extends JsonResource
{
    public function toArray($request): array
    {
        return [
            'id' => $this->id,
{% for f in tiny_fields %}
            '{{ f.name }}' => $this->{{ f.name }},
{% endfor %}
        ];
    }
}
