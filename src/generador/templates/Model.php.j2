<?php

namespace App\Models\db{{ manifest.prefijo }};

use Essa\APIToolKit\Filters\Filterable;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\BelongsTo;
use Illuminate\Database\Eloquent\SoftDeletes;

class {{ manifest.model_class }} extends Model
{
    use SoftDeletes, Filterable;

    protected $connection  = '{{ manifest.connection_name }}';
    protected $table       = '{{ manifest.table }}';

    // Toda tabla de negocio del patrón (crud básico) tiene pkid + id:
    protected $primaryKey  = 'id';
    public    $incrementing = false;
    protected $keyType     = 'string';

    // Campos asignables por el Service.
    // Excluye siempre: pkid, id, created_at, updated_at, deleted_at
    // (id y los *_by_id los asigna el CrudService automáticamente)
    protected $fillable = [
        'id',
{% for f in fields %}
        '{{ f.name }}',
{% endfor %}
        'created_by_id',
        'updated_by_id',
        'deleted_by_id',
    ];
{% if casts %}

    protected $casts = [
{% for name, cast in casts %}
        '{{ name }}' => '{{ cast }}',
{% endfor %}
    ];
{% endif %}
{% for rel in relations %}

    public function {{ rel.method }}(): BelongsTo
    {
        return $this->belongsTo({{ rel.model_class }}::class, '{{ rel.column }}', 'pkid');
    }
{% endfor %}

    // created_by_id/updated_by_id/deleted_by_id son FKs como cualquier otra —
    // ver `const RELATIONS` en {{ manifest.modulo_studly }}Service y Auditoría.md.
    public function created_by(): BelongsTo
    {
        return $this->belongsTo(\{{ manifest.user_model_class }}::class, 'created_by_id', 'pkid');
    }

    public function updated_by(): BelongsTo
    {
        return $this->belongsTo(\{{ manifest.user_model_class }}::class, 'updated_by_id', 'pkid');
    }

    public function deleted_by(): BelongsTo
    {
        return $this->belongsTo(\{{ manifest.user_model_class }}::class, 'deleted_by_id', 'pkid');
    }
}
